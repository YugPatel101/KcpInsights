# KcpInsights backend configuration. Copy to backend/.env and adjust.
# Placeholders only — never commit real secrets.

KCP_ENVIRONMENT=development
# SQLite by default (zero cost). PostgreSQL also works, e.g. postgresql+psycopg://user:pass@host/db
# KCP_DATABASE_URL=sqlite:///./data/kcpinsights.db
KCP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mode C: hosts the server may fetch official documents from (https only).
KCP_SOURCE_ALLOWED_HOSTS=www.sebi.gov.in,sebi.gov.in,www.nseindia.com,nsearchives.nseindia.com,www.bseindia.com,bseindia.com

KCP_MAX_UPLOAD_MB=20
KCP_SESSION_TTL_HOURS=168

# --- Live IPO data (NSE public issue information + official bhavcopy) ------------------
# The scheduler runs inside the API process; set false and run `python -m app.cli worker` to separate it.
KCP_SCHEDULER_ENABLED=true
KCP_INGEST_ENABLED=true
KCP_INGEST_MIN_REQUEST_INTERVAL_SECONDS=2.5
KCP_INGEST_DISCOVERY_MINUTES=360
KCP_INGEST_DETAILS_MINUTES=360
KCP_INGEST_SUBSCRIPTION_MINUTES=20
KCP_INGEST_LISTING_MINUTES=45
KCP_INGEST_HEALTH_MINUTES=30
KCP_INGEST_LISTING_WINDOW_DAYS=120
# Offer documents (RHP) linked on NSE issue pages: downloaded only when new or changed (HEAD check),
# restated financials extracted and reconciled, then scores recalculated. RHP archives are 10–30 MB each.
KCP_INGEST_DOWNLOAD_OFFER_DOCUMENTS=true
KCP_INGEST_DOCUMENTS_MINUTES=60
KCP_INGEST_MAX_DOCUMENTS_PER_RUN=3
KCP_INGEST_MAX_OFFER_DOCUMENT_MB=80
# Stored originals beyond this total are pruned (oldest listed issues first); extracted figures are kept.
KCP_DOCUMENTS_MAX_TOTAL_MB=1500
KCP_DOCUMENT_RECHECK_DAYS=3
KCP_DOCUMENT_WINDOW_DAYS=180
# failed downloads/extractions back off 1, 2, 4, 8 h ... (max 7 days); after this many attempts: dead letter
KCP_DOCUMENT_MAX_ATTEMPTS=5
# SEBI draft (DRHP) and red herring (RHP) filings: first listing page, twice a day
KCP_INGEST_SEBI_FILINGS=true
KCP_INGEST_FILINGS_MINUTES=720
# listed peers: latest official close (NSE bhavcopy) matched through the NSE equity lists
KCP_INGEST_PEER_PRICES_MINUTES=1440
# local OCR for scanned prospectus pages (needs Tesseract: brew install tesseract / apt install tesseract-ocr)
KCP_OCR_ENABLED=true
KCP_OCR_MAX_PAGES=150
KCP_OCR_DPI=300
KCP_OCR_TIME_BUDGET_SECONDS=600
# text | json (one JSON object per log line)
KCP_LOG_FORMAT=text
