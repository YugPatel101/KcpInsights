# KcpInsights backend configuration. Copy to backend/.env and adjust.
# Placeholders only — never commit real secrets.

KCP_ENVIRONMENT=development
# SQLite by default (zero cost). PostgreSQL also works, e.g. postgresql+psycopg://user:pass@host/db
# KCP_DATABASE_URL=sqlite:///./data/kcpinsights.db
KCP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI provider: auto | deterministic | ollama | external
#   auto -> use Ollama when healthy and the model is downloaded, else the deterministic engine
KCP_AI_PROVIDER=auto
KCP_OLLAMA_BASE_URL=http://127.0.0.1:11434
KCP_OLLAMA_MODEL=qwen2.5:3b
KCP_OLLAMA_SMALL_MODEL=qwen2.5:1.5b
# true on machines with < 8 GB RAM
KCP_OLLAMA_USE_SMALL_MODEL=false
KCP_OLLAMA_EMBED_MODEL=nomic-embed-text
KCP_OLLAMA_TIMEOUT_SECONDS=60

# Optional OpenAI-compatible endpoint — disabled by default, never required.
KCP_EXTERNAL_LLM_ENABLED=false
KCP_EXTERNAL_LLM_BASE_URL=
KCP_EXTERNAL_LLM_MODEL=
KCP_EXTERNAL_LLM_API_KEY=

# Mode C: hosts the server may fetch official documents from (https only).
KCP_SOURCE_ALLOWED_HOSTS=www.sebi.gov.in,sebi.gov.in,www.nseindia.com,nsearchives.nseindia.com,www.bseindia.com,bseindia.com

KCP_MAX_UPLOAD_MB=20
KCP_SESSION_TTL_HOURS=168
